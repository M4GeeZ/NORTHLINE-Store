# Create server/.env from this template. Replace all placeholders locally.
PORT=5000
MONGO_URI=mongodb+srv://ATLAS_USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/codealpha_northline?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CLIENT_URL=http://localhost:5173
NODE_ENV=development
AUTO_SEED=true

# Gmail transactional notifications. Use a Google App Password, NOT your normal Gmail password.
# The email sender will display as "NORTHLINE Studio <mughees1275@gmail.com>".
STORE_OWNER_EMAIL=mughees1275@gmail.com
SMTP_USER=mughees1275@gmail.com
SMTP_APP_PASSWORD=REPLACE_WITH_GMAIL_16_CHAR_APP_PASSWORD
STORE_PUBLIC_URL=http://localhost:5173

# Firebase Admin SDK service account (optional, needed for Google/phone sign-in)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
